# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# Include the database name in the path, e.g. /iqra
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/iqra?retryWrites=true&w=majority"

# Password the admin office uses to sign in.
ADMIN_PASSWORD="change-me"

# Secret used to sign session cookies. At least 32 random characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=""

# Timezone used to decide the "current month" for fee calculations.
APP_TIMEZONE="Asia/Karachi"
